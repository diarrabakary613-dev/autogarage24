# =====================================================================
# AutoGarage24 — variabili d'ambiente (ESEMPIO, nessun valore reale)
# Copia questo file in ".env.local" e inserisci i valori del tuo progetto
# Supabase (Dashboard → Project Settings → API Keys).
# Il file .env.local NON va mai condiviso né caricato su GitHub.
# =====================================================================

# URL pubblico del progetto Supabase (es. https://abcd1234.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chiave "publishable" (sb_publishable_...). È pubblica per design:
# la sicurezza dei dati è garantita dalle policy RLS nel database.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Indirizzo del sito, usato nei link delle email (senza "/" finale)
# Sviluppo: http://localhost:3000 — Produzione: https://www.autogarage24.it
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chiave SEGRETA (sb_secret_... o service_role). Solo per script lato
# server, es. "npm run admin:bootstrap". MAI con prefisso NEXT_PUBLIC_,
# mai nel browser, mai nel codice.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------
# Facoltative (Fasi 32–33). Tutti identificativi PUBBLICI, non segreti.
# Se vuoti: nessun banner cookie e nessuno script di terze parti.
# Gli strumenti si caricano solo dopo il consenso dell'utente.
# ---------------------------------------------------------------------
# Google Analytics 4 (es. G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=
# Google Ads, tag di conversione (es. AW-123456789)
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Meta Pixel (solo cifre)
NEXT_PUBLIC_META_PIXEL_ID=
# TikTok Pixel
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Codice del meta tag di verifica di Google Search Console / Bing Webmaster
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
# I token delle API di conversione lato server (Meta CAPI, Google Ads API) sono SEGRETI:
# non vanno mai in variabili NEXT_PUBLIC_. L'integrazione lato server non è implementata.

# =====================================================================
# AMBIENTI (Fase 35)
# Ogni ambiente ha un proprio progetto Supabase e i propri valori:
#   Development → .env.local sul tuo computer (progetto Supabase di sviluppo)
#   Staging     → variabili dell'app di prova sull'hosting (progetto Supabase di prova)
#   Production  → variabili dell'app di produzione (progetto mcjlyqplfiyhrxvazzzk)
# Non copiare mai dati reali in sviluppo o in prova, né dati di prova in produzione.
# NEXT_PUBLIC_SITE_URL deve corrispondere al dominio dell'ambiente
# (es. https://staging.<dominio> per la prova, https://www.<dominio> per la produzione).
# =====================================================================

# =====================================================================
# SECRET DELLA EDGE FUNCTION "send-emails" (email transazionali)
# NON vanno in questo file né sull'hosting: si impostano in
# Supabase → Edge Functions → Secrets (oppure: supabase secrets set NOME=valore).
# Elencati qui solo come promemoria. SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY
# sono forniti automaticamente da Supabase alle Edge Function.
# =====================================================================
# RESEND_API_KEY=            # chiave del provider email (segreta)
# EMAIL_FROM=                # mittente verificato, es. "AutoGarage24 <notifiche@dominio>"
# SITE_URL=                  # stesso valore di NEXT_PUBLIC_SITE_URL dell'ambiente
# CRON_SECRET=               # segreto lungo e casuale, condiviso con il job pg_cron che invoca la funzione

# =====================================================================
# NOTIFICHE PUSH (non attive) — chiavi VAPID da generare solo all'attivazione
# (docs/NOTIFICHE_PUSH.md). La privata è segreta e va solo nei secret server.
# =====================================================================
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
